# Copy to .env.local. Only public values: never put a secret in a NEXT_PUBLIC_ variable.
# Local dev without the proxy: the Rook server's URL; the client adds /api/v1. Leave it UNSET on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:7860
# Vercel (build time): the Hugging Face Space origin that /api/v1/* is rewritten to, e.g. https://<user>-rook.hf.space.
# A public URL, not a secret. With it set (and NEXT_PUBLIC_API_URL unset) the browser calls same-origin /api/v1.
ROOK_API_PROXY_TARGET=
# Supabase project URL and its *anon* key (public by design). Never the service or JWT secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
