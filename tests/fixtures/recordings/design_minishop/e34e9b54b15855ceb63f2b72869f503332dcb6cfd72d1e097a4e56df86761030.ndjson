       ],\\n          \\\"int\\\": [\\n            1,\\n            50\\n          ]\\n        }\\n      },\\n      \\\"request\\\": {\\n        \\\"json\\\": {\\n          \\\"amount\\\": \\\"{{p.amount}}\\\"\\n        },\\n        \\\"method\\\": \\\"POST\\\",\\n        \\\"path\\\": \\\"/orders/{{ref.order_id}}/refunds\\\"\\n      },\\n      \\\"requires\\\": [\\n        \\\"order_id\\\"\\n      ],\\n      \\\"weight\\\": 1.0\\n    },\\n    {\\n      \\\"actor\\\": \\\"customer\\\",\\n      \\\"capture\\\": {},\\n      \\\"name\\\": \\\"cancel_order\\\",\\n      \\\"params\\\": {},\\n      \\\"request\\\": {\\n        \\\"method\\\": \\\"POST\\\",\\n        \\\"path\\\": \\\"/orders/{{ref.order_id}}/cancel\\\"\\n      },\\n      \\\"requires\\\": [\\n        \\\"order_id\\\"\\n      ],\\n      \\\"weight\\\": 1.0\\n    },\\n    {\\n      \\\"actor\\\": \\\"admin\\\",\\n      \\\"capture\\\": {},\\n      \\\"name\\\": \\\"ship_order\\\",\\n      \\\"params\\\": {},\\n      \\\"request\\\": {\\n        \\\"method\\\": \\\"POST\\\",\\n        \\\"path\\\": \\\"/orders/{{ref.order_id}}/ship\\\"\\n      },\\n      \\\"requires\\\": [\\n        \\\"order_id\\\"\\n      ],\\n      \\\"weight\\\": 1.0\\n    },\\n    {\\n      \\\"actor\\\": \\\"admin\\\",\\n      \\\"capture\\\": {},\\n      \\\"name\\\": \\\"admin_export\\\",\\n      \\\"params\\\": {},\\n      \\\"request\\\": {\\n        \\\"method\\\": \\\"GET\\\",\\n        \\\"path\\\": \\\"/admin/export\\\"\\n      },\\n      \\\"requires\\\": [],\\n      \\\"weight\\\": 1.0\\n    }\\n  ],\\n  \\\"actors\\\": [\\n    \\\"customer\\\",\\n    \\\"admin\\\"\\n  ]\\n}\\n\\n# Rules\\n- Use only the action names and rule ids given above; params must fit each action's declared ranges.\\n- Keep scenarios short (at most 8 steps). Use `{\\\"parallel\\\": [step, step]}` to send steps concurrently.\\n- The engine runs the scenarios and decides whether a rule breaks; you only propose them.\\n\\n# Output\\nExample of a valid fi